# M-Pesa Daraja API (Lipa na M-Pesa Online / STK Push)
# Get Consumer Key + Secret by creating an app at https://developer.safaricom.co.ke
# Sandbox test credentials (Shortcode + Passkey) are on that app's "Test Credentials" page.

# sandbox | production
MPESA_ENV=sandbox

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Till Number (Buy Goods) used as both BusinessShortCode and PartyB
MPESA_SHORTCODE=
MPESA_PASSKEY=

# CustomerBuyGoodsOnline (Till) | CustomerPayBillOnline (Paybill)
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Must be a public HTTPS URL Safaricom can reach — your deployed domain,
# or an ngrok tunnel while testing locally. Cannot be localhost.
MPESA_CALLBACK_URL=https://your-domain.example.com/api/mpesa/callback
